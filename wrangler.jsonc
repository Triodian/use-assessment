// Cloudflare Worker configuration for the AI Use Assessment. Cloudflare reads this file on every deploy from GitHub.
{
  "name": "use-assessment",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // run_worker_first: every request reaches src/worker.js first, so pages can require sign-in (lib/identity/session.js).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Only reachable at the custom domain (behind Cloudflare Access sign-in).
  // The default workers.dev address and preview addresses are switched off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "use-assessment.triodian.com", "custom_domain": true }],

  "d1_databases": [
    { "binding": "DB", "database_name": "use-assessment-db", "database_id": "e7e9a50f-cfda-4ddd-938e-2ae38b4e6553" }
  ],
  // IDENTITY (development plan tasks 1B.2 and 1B.3): the suite's shared identity database, one per environment, bound to
  // all four engagement apps. With it, people are added once, roles are kept per app, and one sign-in covers every app
  // on SUITE_COOKIE_DOMAIN (the cookie SUITE_SESSION_COOKIE; the test sites use their own name so live and test stay apart).
  // Each app copies its own users in the first time it starts with the binding. Create the databases once:
  //   npx wrangler d1 create triodian-identity      and      npx wrangler d1 create triodian-identity-test
  // then add, here and in the test env with the test database:
  //   { "binding": "IDENTITY", "database_name": "triodian-identity", "database_id": "<id from the create command>" }
  "observability": { "enabled": true },

  // Daily at 07:00 Brisbane time: remind counsel about questions open for a week or more (lib/core/notify.js).
  "triggers": { "crons": ["0 21 * * *"] },

  // Email notifications are switched on. They are sent through Cloudflare Email Service from
  // notifications@triodian.com, which needs triodian.com onboarded in Email Service (Email Sending). Until it is,
  // each send fails and is listed as Failed, with the reason, in Admin → Notifications; saves are never affected.
  // To stop sending, set NOTIFY_SENDING to "off": messages are then held and listed in Admin → Notifications.
  "send_email": [{ "name": "EMAIL" }],

  // The "Load from the Risk Appetite app" button reads the issued calibration set from
  // APPETITE_URL/api/calibration-set using a Cloudflare Access service token. The token's two halves are
  // secrets, set in Cloudflare (Worker → Settings → Variables and secrets), never in this file:
  //   APPETITE_CLIENT_ID, APPETITE_CLIENT_SECRET
  // Until both are set the button explains that the link is not set up, and a file can be loaded instead.
  // DEMO_ADMINS (demo addition): comma-separated emails made active administrators when they sign in.
  // Empty it ("") on a client deployment. See lib/core/api.js.
  // DEMO_LOGIN (demo addition): username sign-in for the shared demo account, password held only as a PBKDF2 hash;
  // anyCharAt [3] accepts any character in place of the £ in trio_demo's password.
  // DEMO_SESSION_KEY (a Worker secret, not set here; development plan task 0.1) signs the demo sign-in cookie, shared
  // across triodian.com; it must be the same in every app and is only accepted for the demo account's own email.
  // SUITE_DEMO "on" shows the demo band and app switcher (task 0.3). See lib/identity/session.js.
  "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite", "DEMO_LOGIN": "[{\"username\": \"trio_demo\", \"email\": \"demo@triodian.com\", \"hash\": \"pbkdf2-sha256$100000$ae_ndll6YbjpSddRDhFBLg$HAVf7tKSohiJck-ohKQ1KYft_e1YpCuWF8xcJgmjNqM\", \"anyCharAt\": [3]}]", "DEMO_ADMINS": "demo@triodian.com", "APPETITE_URL": "https://risk-appetite.triodian.com", "NOTIFY_SENDING": "on", "NOTIFY_FROM": "notifications@triodian.com" },

  // Test copy: use-assessment-test.triodian.com, with its own database. It reads the Risk Appetite test site.
  // Deployed with `npx wrangler deploy --env test` (see docs/test-site.md).
  "env": {
    "test": {
      "name": "use-assessment-test",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "use-assessment-test.triodian.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "use-assessment-test-db", "database_id": "8da15baa-c86e-4134-9bee-7412e064dc98" }
      ],
      "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite_test", "DEMO_LOGIN": "[{\"username\": \"trio_demo\", \"email\": \"demo@triodian.com\", \"hash\": \"pbkdf2-sha256$100000$ae_ndll6YbjpSddRDhFBLg$HAVf7tKSohiJck-ohKQ1KYft_e1YpCuWF8xcJgmjNqM\", \"anyCharAt\": [3]}]", "DEMO_ADMINS": "demo@triodian.com", "SITE_LABEL": "Test site", "SITE_URL": "https://use-assessment-test.triodian.com", "APPETITE_URL": "https://risk-appetite-test.triodian.com", "NOTIFY_SENDING": "on", "NOTIFY_FROM": "notifications@triodian.com" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    },

    // CLIENT DEPLOYMENT PROFILE (development plan task 0.2): a copy of AI Use Assessment for one client, with no demonstration
    // parts. No demo sign-in (DEMO_LOGIN empty), no demo administrators, no demo band or app switcher (SUITE_DEMO off),
    // and DEMO_SESSION_KEY is not set as a secret. To deploy one: replace the CLIENT placeholders, create the client's
    // D1 database and put its id below, create the client's Access application for /auth/email and set its tag as
    // the ACCESS_AUD secret (the team domain is in lib/config.js), then run `npx wrangler deploy --env client`.
    // Email stays held (NOTIFY_SENDING off) until the client's sender is set up.
    "client": {
      "name": "use-assessment-client",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "use-assessment.CLIENT-DOMAIN.example", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "use-assessment-client-db", "database_id": "REPLACE-WITH-THE-CLIENT-DATABASE-ID" }
      ],
      "vars": { "SUITE_DEMO": "off", "SUITE_COOKIE_DOMAIN": "CLIENT-DOMAIN.example", "SUITE_SESSION_COOKIE": "tri_suite", "DEMO_LOGIN": "", "DEMO_ADMINS": "", "SITE_URL": "https://use-assessment.CLIENT-DOMAIN.example", "APPETITE_URL": "https://risk-appetite.CLIENT-DOMAIN.example", "NOTIFY_SENDING": "off", "NOTIFY_FROM": "" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    }
  }
}
